<Window x:Class="task_monitor.ConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="TaskMonitor"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True">
    <!-- First-run elevation consent. Shown UNelevated, before any UAC request; only
         "允许" sets DialogResult=true — 不允许 / ✕ / Esc all count as refusal. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="本工具的部分功能需要管理员权限，为保证使用体验，工具将始终申请管理员权限并保持在管理员权限的状态下运行，是否允许？"
                   TextWrapping="Wrap"
                   Style="{DynamicResource BodyTextBlockStyle}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="不允许"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="允许"
                    MinWidth="88"
                    Style="{DynamicResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="Allow_Click" />
        </StackPanel>
    </Grid>
</Window>
