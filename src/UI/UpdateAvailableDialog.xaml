<Window x:Class="task_monitor.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Title="TaskMonitor"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ui:WindowHelper.UseModernWindowStyle="True">
    <!-- Startup update prompt (UpdateChecker): shown only when the configured source
         reports a tag newer than the running build AND the user hasn't picked 不再提醒
         for that exact tag. 立即更新 opens the source's releases page; 不再提醒 persists
         the tag to settings.yaml (UpdateChecker owns the follow-up); 稍后 / ✕ / Esc
         just close — the next startup asks again. Same window family as
         LegacyOsWarningDialog: iNKORE modern window, shown elevated. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="MessageText"
                   TextWrapping="Wrap"
                   Style="{DynamicResource BodyTextBlockStyle}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="不再提醒"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    Click="Ignore_Click" />
            <Button Content="稍后"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="立即更新"
                    MinWidth="88"
                    Style="{DynamicResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="Update_Click" />
        </StackPanel>
    </Grid>
</Window>
